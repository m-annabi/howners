<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Inventaire du mobilier des logements meublés (décret n° 2015-981), établi « dans les mêmes
         formes » que l'état des lieux et annexé au bail (loi 89 art. 25-5). Stocké en JSON sur
         l'état des lieux, à côté de room_conditions. Cf. AUDIT-BAUX-CONFORMITE.md, item T-02. -->
    <changeSet id="109-edl-furniture-inventory" author="claude">
        <addColumn tableName="etat_des_lieux">
            <column name="furniture_inventory" type="jsonb"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
