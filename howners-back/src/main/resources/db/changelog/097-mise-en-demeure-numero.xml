<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Numéro d'émission des mises en demeure (MED-2026-0001), alloué à la
         génération du courrier via la séquence par bailleur/année. Porté par le
         paiement (une seule mise en demeure par paiement, garde relance_niveau).
         Nullable : les mises en demeure déjà émises n'en reçoivent pas. -->
    <changeSet id="097-01" author="claude">
        <addColumn tableName="payments">
            <column name="mise_en_demeure_numero" type="VARCHAR(30)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
