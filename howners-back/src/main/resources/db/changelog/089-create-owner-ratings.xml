<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.28.xsd">

    <changeSet id="089-create-owner-ratings" author="howners">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="owner_ratings"/></not>
        </preConditions>

        <createTable tableName="owner_ratings">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="rater_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="rental_id" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="communication_rating" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="responsiveness_rating" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="contract_respect_rating" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="overall_rating" type="NUMERIC(3,2)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="owner_ratings" baseColumnNames="owner_id"
            constraintName="fk_owner_ratings_owner"
            referencedTableName="users" referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="owner_ratings" baseColumnNames="rater_id"
            constraintName="fk_owner_ratings_rater"
            referencedTableName="users" referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="owner_ratings" baseColumnNames="rental_id"
            constraintName="fk_owner_ratings_rental"
            referencedTableName="rentals" referencedColumnNames="id"/>

        <createIndex indexName="idx_owner_ratings_owner_id" tableName="owner_ratings">
            <column name="owner_id"/>
        </createIndex>

        <createIndex indexName="idx_owner_ratings_rater_rental" tableName="owner_ratings" unique="true">
            <column name="rater_id"/>
            <column name="rental_id"/>
        </createIndex>

        <sql>
            ALTER TABLE owner_ratings ADD CONSTRAINT chk_owner_communication_rating CHECK (communication_rating BETWEEN 1 AND 5);
            ALTER TABLE owner_ratings ADD CONSTRAINT chk_owner_responsiveness_rating CHECK (responsiveness_rating BETWEEN 1 AND 5);
            ALTER TABLE owner_ratings ADD CONSTRAINT chk_owner_contract_respect_rating CHECK (contract_respect_rating BETWEEN 1 AND 5);
        </sql>
    </changeSet>

</databaseChangeLog>
