# ============================================
# Howners — Environnement de STAGING (ex. AWS Lightsail / EC2)
# ============================================
# Copier ce fichier en `.env.prod` sur le serveur de staging puis remplir
# chaque valeur marquée CHANGER. Lancer ensuite depuis la racine du repo :
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# (le nom .env.prod est celui attendu par docker-compose.prod.yml via env_file)
# NE JAMAIS committer le fichier rempli. chmod 600 recommandé.
# Guide pas à pas : DEPLOY-AWS.md

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Domaine (Caddy + build du frontend) ---
# Le front est servi sur APP_DOMAIN, l'API sur api.APP_DOMAIN. Les DEUX entrées
# DNS doivent pointer vers l'IP du serveur. APP_DOMAIN est aussi injecté au
# build du frontend (environment.prod.ts) — rebuilder l'image si le domaine change.
APP_DOMAIN=staging.mondomaine.fr        # CHANGER
ACME_EMAIL=moi@mondomaine.fr            # CHANGER (notifications Let's Encrypt)

# --- Database (conteneur postgres du compose) ---
POSTGRES_DB=howners_db
POSTGRES_USER=howners_user
POSTGRES_PASSWORD=                      # CHANGER (long et aléatoire : openssl rand -base64 24)
# DATABASE_URL est composé automatiquement par docker-compose.prod.yml.

# --- JWT Authentication ---
JWT_SECRET=                             # CHANGER (openssl rand -base64 72)
JWT_EXPIRATION=86400000

# --- Stockage S3 : MinIO du compose (défaut) OU vrai S3 AWS ---
# Option A (défaut) : MinIO conteneurisé, exposé publiquement par Caddy sur
# s3.APP_DOMAIN (entrée DNS s3.<APP_DOMAIN> requise — cf. Caddyfile). Les URLs
# présignées (photos, documents) sont générées sur MINIO_ENDPOINT et ouvertes
# par le navigateur : il DOIT être public.
MINIO_ROOT_USER=howners_minio
MINIO_ROOT_PASSWORD=                    # CHANGER (openssl rand -base64 24)
MINIO_BUCKET=howners-documents
MINIO_ENDPOINT=https://s3.staging.mondomaine.fr   # CHANGER (aligné sur APP_DOMAIN)
# Option B : vrai S3 AWS — supprimer les services minio/minio-setup du compose,
# créer un bucket privé + un utilisateur IAM limité à ce bucket, puis :
#   MINIO_ENDPOINT=https://s3.eu-west-3.amazonaws.com
#   MINIO_ROOT_USER=<access key IAM>
#   MINIO_ROOT_PASSWORD=<secret key IAM>
#   MINIO_BUCKET=<nom du bucket>
# (le backend utilise le SDK AWS ; seule la cible change)

# --- Limites d'upload ---
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=25MB
MAX_DOCS_PER_OWNER=500

# --- SMTP Email ---
# Staging : utiliser une boîte de capture (Mailtrap.io, plan gratuit) pour ne
# jamais envoyer de vrai email depuis le staging. Valeurs dans le dashboard Mailtrap.
SMTP_HOST=sandbox.smtp.mailtrap.io      # CHANGER si autre fournisseur
SMTP_PORT=587
SMTP_USERNAME=                          # CHANGER
SMTP_PASSWORD=                          # CHANGER
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_FROM=noreply@staging.mondomaine.fr

# --- Stripe (clés de TEST uniquement en staging) ---
STRIPE_SECRET_KEY=sk_test_...           # CHANGER
STRIPE_PUBLIC_KEY=pk_test_...           # CHANGER
STRIPE_WEBHOOK_SECRET=whsec_...         # CHANGER (webhook pointé sur api.APP_DOMAIN)
STRIPE_PLATFORM_FEE_PERCENT=2.5

# --- E-Signature ---
# La signature canvas in-app fonctionne sans DocuSign. Pour tester DocuSign,
# rester sur l'environnement demo.
ESIGNATURE_PROVIDER=docusign
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_PATH=https://account-d.docusign.com
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_IMPERSONATED_USER_GUID=
DOCUSIGN_WEBHOOK_SECRET=

# --- Application URLs ---
BACKEND_URL=https://api.staging.mondomaine.fr    # CHANGER (aligné sur APP_DOMAIN)
FRONTEND_URL=https://staging.mondomaine.fr       # CHANGER (aligné sur APP_DOMAIN)
CORS_ALLOWED_ORIGINS=https://staging.mondomaine.fr   # CHANGER

# --- Observabilité Sentry (facultatif en staging) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1
